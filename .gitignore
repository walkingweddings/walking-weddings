# Admin journal creator: uploaded user media (drafts ARE tracked so they
# survive Railway redeploys — see syncToGitHub calls in admin/server.js)
assets/images/journal/*
!assets/images/journal/.gitkeep

# Environment
.env
.env.local

# Anfragen aus dem Kontaktformular. Auf Railway liegen sie auf dem Volume
# (/data/leads) — faellt das weg, schreibt admin/storage.js hierher zurueck.
# Sie enthalten Namen, E-Mail-Adressen und Telefonnummern und duerfen unter
# keinen Umstaenden im oeffentlichen Repo landen.
admin/leads/
